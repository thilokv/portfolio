# ---------------------------------------------------------------------------
# CDC CareOS environment variables. Copy to `.env.local` and fill in values.
# NEVER commit real values. NEVER prefix secrets with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Runtime database role (restricted: no table ownership, no BYPASSRLS).
DATABASE_URL=postgres://careos_app:CHANGE_ME@localhost:5432/careos_dev

# Migration/owner role (used only by `npm run db:migrate` and seeding).
DATABASE_OWNER_URL=postgres://careos_owner:CHANGE_ME@localhost:5432/careos_dev

# Name of the runtime role that migrations grant privileges to.
DATABASE_APP_ROLE=careos_app

# Use TLS for the database connection in production (Supabase/Neon require it).
DATABASE_SSL=false

# Public base URL of the app (used in password-reset links).
APP_URL=http://localhost:3000

# Session lifetime (hours) and idle timeout (minutes).
SESSION_MAX_AGE_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=60

# Where uploaded documents are stored (outside /public). Must be private.
STORAGE_DIR=./storage

# AI provider: "mock" (default, free, offline) or "anthropic" (paid; requires approval).
AI_PROVIDER=mock
# Only needed when AI_PROVIDER=anthropic. Server-side only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Email delivery for password resets: "console" logs the link on the server
# (development only). Configure SMTP later for production.
MAIL_TRANSPORT=console
